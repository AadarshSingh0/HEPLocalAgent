# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environments
.venv/
venv/
env/

# Generated runtime output
/results/
/logs/

# Generated machine configuration and installer backups
/configs/local_paths.json
/configs/ollama_host
/configs/conda_root
/configs/*.before_bootstrap

# Operating systems and editors
.DS_Store
.idea/
.vscode/
*~

# Generated package metadata
*.egg-info/

# local helper/patch downloads
*.patch
apply_increment_*.py

# recorded, machine-specific acceptance outputs
tests/acceptance/scenarios.*.json
!tests/acceptance/scenarios.template.json

/.hep-stack/
# Generated offline evaluation output; only the curated publication package is tracked.
/evaluation/results/*
!/evaluation/results/README.md
!/evaluation/results/published/
!/evaluation/results/published/**
